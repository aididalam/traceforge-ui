# Public API build configuration. Empty uses same-origin browser requests.
NEXT_PUBLIC_API_BASE_URL=
# Server-only public API origin. Required when starting production; no credentials.
TRACEFORGE_PUBLIC_API_ORIGIN=http://127.0.0.1:3000

# Server-only operator gateway; no API token or password configuration.
TRACEFORGE_OPERATOR_API_ORIGIN=http://127.0.0.1:3000
# Exact browser site origin for operator POST Origin/CSRF validation.
# Production uses the deployed HTTPS origin. Local example:
TRACEFORGE_SITE_ORIGIN=http://127.0.0.1:3100
