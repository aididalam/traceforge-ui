{
  "name": "@traceforge/ui",
  "version": "0.30.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Public, opt-in TraceForge provenance viewer",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "verify:live-batch": "node scripts/verify-live-batch.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:e2e",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "jsqr": "^1.4.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-select": "5.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
